# ==============================================================================
# EKA Production Environment Configuration (.env.production.example)
# ==============================================================================
# Live Production environment variables. Set in Vercel / Cloudflare secret dashboard.
# NEVER commit production secrets to Git.

# --- Supabase Production Instance ---
VITE_SUPABASE_URL=https://prod-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=prod-anon-key
VITE_SUPABASE_PROJECT_ID=prod-project-ref
SUPABASE_URL=https://prod-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=prod-service-role-key-backend-only
DATABASE_URL=postgresql://postgres:prod-password@db.prod-project-ref.supabase.co:5432/postgres

# --- Google Integrations (Restricted to eka.earth) ---
# Restricted to HTTPS domain eka.earth
VITE_GOOGLE_MAPS_API_KEY=prod-google-maps-browser-key
# Production DPDP-compliant GA4 Telemetry
VITE_GA4_MEASUREMENT_ID=G-PROD0000000
# Google Gemini Native AI Production Key
GEMINI_API_KEY=prod-gemini-api-key
VITE_GEMINI_API_KEY=prod-gemini-api-key

# --- Razorpay Live Payments, Subscriptions & Creator Payouts ---
RAZORPAY_KEY_ID=rzp_live_your_production_key_id
RAZORPAY_KEY_SECRET=your_production_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_production_webhook_secret
RAZORPAY_ACCOUNT_ID=acc_your_live_account_id
RAZORPAYX_ACCOUNT_NUMBER=your_razorpayx_current_account_number
RAZORPAYX_CONFIG={"channel":"IMPS","purpose":"payout"}
PAYMENT_PROVIDER=razorpay

# --- Observability ---
VITE_SENTRY_DSN=https://...
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://app.posthog.com

# --- Production Canonical Domain ---
VITE_SITE_URL=https://eka.earth
