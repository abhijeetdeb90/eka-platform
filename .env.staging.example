# Staging / Preview branch deployment environment variables.

# --- Supabase Staging Instance ---
VITE_SUPABASE_URL=https://staging-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=staging-anon-key
VITE_SUPABASE_PROJECT_ID=staging-project-ref
SUPABASE_URL=https://staging-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=staging-service-role-key
DATABASE_URL=postgresql://postgres:staging-password@db.staging-project-ref.supabase.co:5432/postgres

# --- Google Integrations (Staging Domain) ---
VITE_GOOGLE_MAPS_API_KEY=staging-google-maps-browser-key
VITE_GA4_MEASUREMENT_ID=G-STAGING000
GEMINI_API_KEY=staging-gemini-api-key
VITE_GEMINI_API_KEY=staging-gemini-api-key

# --- Stripe Billing (Test Mode) ---
STRIPE_WEBHOOK_SECRET=whsec_staging_test_secret
STRIPE_SECRET_KEY=sk_test_staging_secret

# --- Staging Domain ---
VITE_SITE_URL=https://staging.eka.earth
