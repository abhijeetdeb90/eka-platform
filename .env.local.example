# ==============================================================================
# EKA Local Development Environment Configuration (.env.local.example)
# ==============================================================================
# Copy to .env.local for local development.

# --- Supabase Local / Dev Instance ---
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-local-anon-key
VITE_SUPABASE_PROJECT_ID=local-eka-dev
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your-supabase-local-service-role-key
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Google Integrations (Localhost) ---
# Google Maps Platform (Development Browser Key)
VITE_GOOGLE_MAPS_API_KEY=your-dev-google-maps-browser-key
# Google Analytics 4 (Development Measurement ID - optional)
VITE_GA4_MEASUREMENT_ID=G-DEV0000000
# Google Gemini Native AI API (Local Development Key)
GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_API_KEY=your-gemini-api-key

# --- Localhost Redirect Base ---
VITE_SITE_URL=http://localhost:5173
PORT=5173
