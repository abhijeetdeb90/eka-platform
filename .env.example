# ==============================================================================
# EKA Infrastructure & Integration Environment Blueprint
# ==============================================================================
# Copy this file to .env and fill in your environment-specific credentials.
# NEVER commit production secrets, private keys, or API tokens to source control.

# --- 1. Supabase & PostgreSQL ------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-backend-only
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# --- 2. Upstash Redis & Distributed Rate Limiting ---------------------------
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
REDIS_URL=redis://default:password@your-redis-host:6379

# --- 3. Observability & Telemetry (Sentry & PostHog) ------------------------
SENTRY_DSN=https://examplePublicKey@o000000.ingest.sentry.io/0000000
VITE_SENTRY_DSN=https://examplePublicKey@o000000.ingest.sentry.io/0000000
POSTHOG_KEY=phc_your_posthog_project_api_key
VITE_POSTHOG_KEY=phc_your_posthog_project_api_key
POSTHOG_HOST=https://app.posthog.com
VITE_POSTHOG_HOST=https://app.posthog.com

# --- 4. Cloudflare Edge & Object Storage (R2 / CDN) --------------------------
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=eka-sacred-media
R2_PUBLIC_DOMAIN=https://media.eka.earth

# --- 5. AI Foundation Models & Embeddings -----------------------------------
EMBEDDING_API_KEY=your-openai-or-gemini-embedding-key
GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- 6. Background Queue Workers (BullMQ / Inngest / Cloudflare) ------------
QUEUE_WORKER_URL=https://workers.eka.earth/queue
QUEUE_WORKER_SECRET=your-queue-shared-hmac-secret

# --- 7. n8n Automation & Notion Spec Sync -----------------------------------
N8N_WEBHOOK_SECRET=your-n8n-webhook-shared-secret
N8N_RELEASE_WEBHOOK_URL=https://n8n.eka.earth/webhook/release-notification
NOTION_API_KEY=secret_your-notion-integration-token
NOTION_PRD_DATABASE_ID=your-notion-prd-database-id

# --- 8. Maps & Sacred Geography (Google Maps Platform) ----------------------
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=your-google-maps-browser-key
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=your-tracking-id

# --- 9. Google Analytics 4 (DPDP-Compliant Behavioral Telemetry) ------------
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

