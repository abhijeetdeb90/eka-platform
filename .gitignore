# ==============================================================================
# EKA Platform — Canonical .gitignore
# ==============================================================================

# Environment variables & secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
!.env.local.example
!.env.staging.example
!.env.production.example
*.pem
*.key
*.cert
secrets/
credentials/

# Dependencies
node_modules/
.pnpm-store/

# Build artifacts & runtime caches
dist/
dist-ssr/
.output/
.vinxi/
.tanstack/
.nitro/
.vercel/
.wrangler/
.dev.vars
*.local
supabase/.temp/
.supabase/

# Archives & compressed backups (PREVENTS REPO BLOAT)
*.7z
*.rar
*.zip
*.tar
*.gz
*.bak
*.tmp

# Testing & coverage
test-results/
playwright-report/
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS private files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel
.env*
.agents/
skills-lock.json
set-vercel-envs.ps1
